# Copy to .env (gitignored) and fill in secrets for local integration testing.
#
#   cp .env.example .env

# Required for Cursor provider / harness
CURSOR_API_KEY=

# OpenClaw Control UI auth (bootstrap generates one if empty)
# OPENCLAW_GATEWAY_TOKEN=

# Gateway image tag (match package.json openclaw peer / minHostVersion)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.6.11

# Host port for the dashboard (http://127.0.0.1:18789/)
OPENCLAW_GATEWAY_PORT=18789

# Optional egress proxy for the gateway container
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
# NODE_USE_ENV_PROXY=1

# Set to 1 to enable plugins.entries.cursor.config.local.useHttp1ForAgent on bootstrap
# OPENCLAW_CURSOR_USE_HTTP1=0
