{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["./*.ts", "./src/**/*.ts", "./types/**/*.d.ts"],
  "exclude": ["./**/*.test.ts", "./node_modules/**", "./dist/**"]
}
